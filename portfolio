<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mohammad Faizan Fiaz | Portfolio</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      scroll-behavior:smooth;
      font-family:Arial, Helvetica, sans-serif;
    }

    body{
      background:#0f172a;
      color:white;
      line-height:1.6;
    }

    nav{
      position:fixed;
      top:0;
      width:100%;
      background:rgba(15,23,42,0.95);
      padding:20px 10%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      z-index:1000;
      border-bottom:1px solid rgba(255,255,255,0.1);
    }

    nav h1{
      color:#38bdf8;
      font-size:24px;
    }

    nav ul{
      display:flex;
      gap:20px;
      list-style:none;
    }

    nav a{
      color:white;
      text-decoration:none;
      transition:0.3s;
    }

    nav a:hover{
      color:#38bdf8;
    }

    header{
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      padding:120px 10%;
      background:linear-gradient(to bottom right,#0f172a,#111827);
    }

    .hero h2{
      font-size:55px;
      margin-bottom:15px;
    }

    .hero span{
      color:#38bdf8;
    }

    .hero p{
      max-width:700px;
      margin:auto;
      color:#cbd5e1;
      font-size:18px;
    }

    .btn{
      display:inline-block;
      margin-top:30px;
      padding:14px 28px;
      background:#38bdf8;
      color:#0f172a;
      text-decoration:none;
      font-weight:bold;
      border-radius:8px;
      transition:0.3s;
    }

    .btn:hover{
      transform:translateY(-3px);
      background:#7dd3fc;
    }

    section{
      padding:100px 10%;
    }

    .section-title{
      font-size:40px;
      margin-bottom:40px;
      color:#38bdf8;
      text-align:center;
    }

    .about,
    .skills,
    .projects,
    .contact{
      max-width:1200px;
      margin:auto;
    }

    .about p{
      text-align:center;
      color:#cbd5e1;
      max-width:850px;
      margin:auto;
      font-size:18px;
    }

    .skills-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:20px;
      margin-top:40px;
    }

    .skill-card{
      background:#1e293b;
      padding:25px;
      border-radius:12px;
      text-align:center;
      border:1px solid rgba(255,255,255,0.05);
      transition:0.3s;
    }

    .skill-card:hover{
      transform:translateY(-5px);
      border-color:#38bdf8;
    }

    .projects-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
      gap:25px;
      margin-top:40px;
    }

    .project-card{
      background:#1e293b;
      padding:25px;
      border-radius:12px;
      transition:0.3s;
      border:1px solid rgba(255,255,255,0.05);
    }

    .project-card:hover{
      transform:translateY(-5px);
      border-color:#38bdf8;
    }

    .project-card h3{
      margin-bottom:10px;
      color:#38bdf8;
    }

    .project-card p{
      color:#cbd5e1;
    }

    .contact{
      text-align:center;
    }

    .contact p{
      margin-bottom:15px;
      color:#cbd5e1;
      font-size:18px;
    }

    footer{
      text-align:center;
      padding:25px;
      border-top:1px solid rgba(255,255,255,0.08);
      color:#94a3b8;
    }

    @media(max-width:768px){

      nav{
        flex-direction:column;
        gap:15px;
      }

      .hero h2{
        font-size:40px;
      }

      .hero p{
        font-size:16px;
      }

      .section-title{
        font-size:32px;
      }

    }

  </style>
</head>

<body>

